# 复制成 .env 填好，或在 Zeabur 的服务环境变量里逐条设置。

# ── 必填 ──
# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# MCP 端点和音频链接的路径前缀，是唯一的访问门禁。别用示例里的值。
#   python -c "import secrets;print(secrets.token_hex(16))"
# 设成 3f2a... 的话，客户端连 https://<域名>/3f2a.../mcp
MCP_SECRET=

# ── 选填 ──
# 音频链接的对外前缀。不设的话从请求的 Host 头推导；推导不出来时工具会返回配置错误。
# PUBLIC_BASE_URL=https://your-app.zeabur.app

# ELEVENLABS_MODEL_ID=eleven_v4
# pcm_44100 只有 Pro 及以上套餐能用
# ELEVENLABS_FORMAT=pcm_24000

# 单次稿子的字数上限。这是真正的成本闸门，别设太大。
# MAX_CHARS=1500
# RATE_LIMIT_PER_MIN=6
# 渲染结果保留多久（秒）
# AUDIO_TTL_SECONDS=3600

# 设了才开启 DNS rebinding 保护并只放行这些 Host（逗号分隔）。不设则关闭保护，
# 由 MCP_SECRET 当门禁。填了域名就建议开启。
# ALLOWED_HOSTS=your-app.zeabur.app
